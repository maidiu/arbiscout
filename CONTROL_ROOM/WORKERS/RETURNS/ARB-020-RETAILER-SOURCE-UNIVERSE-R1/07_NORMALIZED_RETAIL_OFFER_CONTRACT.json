  "semantic_invariants": [
    {
      "id": "O01",
      "rule": "MSRP or percent-off never serves as actual verified purchaser price or eBay normal historic price"
    },
    {
      "id": "O02",
      "rule": "seller_type MARKETPLACE_THIRD_PARTY is never rewritten to retailer direct; store separately"
    },
    {
      "id": "O03",
      "rule": "price.total_purchaser_amount null if shipping/tax known required but missing; no arithmetic with partial totals unless labeled limited basis"
    },
    {
      "id": "O04",
      "rule": "identity EXACT_DOCUMENTED must match GTIN or robust MPN+revision, quantity, bundle and condition; no LLM guess upgrades"
    },
    {
      "id": "O05",
      "rule": "availability IN_STOCK_VERIFIED must be same region/fulfillment/checkout time; unknown remains unknown"
    },
    {
      "id": "O06",
      "rule": "coupon account-targeted/loyalty, membership, trade-in and future rebate cannot be counted as generally obtainable price"
    },
    {
      "id": "O07",
      "rule": "vendor discount grade and retailer regular/MSRP comparison never qualify eBay gap; ARB-010 must supply actual completed-sale observations"
    },
    {
      "id": "O08",
      "rule": "license/retention or upstream data rights UNKNOWN => hold for prohibited operation; do not infer from HTTP 200"
    },
    {
      "id": "O09",
      "rule": "source may provide candidate discovery without validating retailer checkout; preserve both source/corroboration events"
    },
    {
      "id": "O10",
      "rule": "refresh/cache/expiry and retractions obey source terms; do not persist merchant content beyond agreed period"
    },
    {
      "id": "O11",
      "rule": "public repo cannot contain private API keys/session cookies/individual shopper data or account-specific offer snapshots without grant"
    },
    {
      "id": "O12",
      "rule": "not enough historical eBay exact completed sales => no baseline or gap, output REFUSE not imputation"
    }
  ],
  "integration_policy": {
    "first_real_consumer": "ARB-031/033 retailer purchase offer",
    "qualifying_pipeline": [
      "DISCOVER",
      "IDENTIFY",
      "VERIFY_PURCHASE_PRICE_AND_STOCK",
      "QUALIFY_SOURCE_USE",
      "JOIN_90D_EBAY_COMPLETED_SALES",
      "ESTIMATE_NORMAL_PRICE",
      "COMPUTE_CONSERVATIVE_GAP",
      "RANK_0_TO_10"
    ],
    "all_future_sale_fields_prohibited": true,
    "production_status": "NOT_IMPLEMENTED",
    "validation": "JSON syntax only; structural schema not executed with fixture runner or independent reviewer"
  },
  "security": "Public repo: synthetic fixtures and nonconfidential source citations only. Provider key and customer-specific prices held only in approved secure store; no live source account access performed."
}
